# Build output. Everything here is reproducible with build.ps1, and the
# assets it contains are copied in from assets\ at build time.
build/

# Packaged installers. These belong on a Releases page, not in the history -
# a 2 MB binary per version bloats every future clone.
dist/

# Full-resolution Figma exports, ~18 MB. Kept out for the same reason: Figma is
# the source of truth for the artwork, and what the app actually ships - the
# downscaled cut-outs in assets\assets\ - is tracked. Re-export from the design
# file to recreate this folder before running make-assets.ps1.
design/

# Local editor and OS noise
.vs/
.idea/
*.user
*.suo
Thumbs.db
desktop.ini
